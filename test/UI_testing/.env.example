# Frontend Application Base URL
APP_BASE_URL=http://localhost:5173

# Backend API Base URL
BACKEND_BASE_URL=http://127.0.0.1:8000

# Dedicated Test Accounts (Do not use production credentials)
TEST_CREATOR_EMAIL=test_creator@example.com
TEST_CREATOR_PASSWORD=Password123!

TEST_PLAYER_EMAIL=test_player@example.com
TEST_PLAYER_PASSWORD=Password123!

# Headless mode for Chrome (true for CI/headless, false to see browser window)
HEADLESS=true

# Wait timeouts in seconds
EXPLICIT_WAIT_TIMEOUT=10
PAGE_LOAD_TIMEOUT=20
