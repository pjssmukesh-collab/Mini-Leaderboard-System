# ──────────────────────────────────────────────
# Mini Leaderboard System — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to Git — it contains secrets!
# This .env.example file is safe to commit (it has only placeholders).
# ──────────────────────────────────────────────

# ── General ──
APP_NAME=Mini Leaderboard System
APP_VERSION=1.0.0
DEBUG=True

# ── Database ──
DATABASE_URL=sqlite:///./mini_leaderboard.db

# ── Security ──
SECRET_KEY=change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS (comma-separated frontend URLs) ──
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]
